# Copy this file to `.env.local` and paste the values from the Supabase project
# (Dashboard -> Project Settings -> API). `.env.local` is git-ignored.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Automatic transcription draft (optional, free, runs in the browser: the audio never
# leaves the device). Leave empty to switch it off.
#   mock             fake sentences, to try the screens
#   browser-whisper  Whisper in the browser (downloads a model the first time)
VITE_TRANSCRIPTION=browser-whisper
# Whisper model for browser-whisper. Default Xenova/whisper-base (~80 MB, quicker);
# Xenova/whisper-small (~250 MB) is more accurate and slower; Xenova/whisper-tiny is the lightest.
VITE_TRANSCRIPTION_MODEL=Xenova/whisper-small
